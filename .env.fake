# Loaded automatically by `vite --mode fake`. Selects the fake backend
# (no Firebase, no network) so the SPA can be driven entirely offline —
# useful for local development, Playwright-based UI smoke tests, and
# verifying the layout without a doctorina.com account.

VITE_BACKEND=fake

# Firebase keys still get inlined as empty strings (Vite reserves
# `import.meta.env.VITE_*`), which is fine because nothing in the fake
# code path calls the Firebase SDK — see src/shared/api/firebase.ts.
VITE_FIREBASE_API_KEY=fake
VITE_FIREBASE_AUTH_DOMAIN=fake.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fake
VITE_FIREBASE_STORAGE_BUCKET=fake.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
